{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "technical-maintenance-assistant",
  "main": "src/index.js",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maintenance-assistant-db",
      "database_id": "594daac4-ed05-4a95-968e-0318af74f823",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash"
  }
}
